# Copy to .env (or export) only if you need to override defaults.
# The API and the terrain build need no credentials: those datasets are public on AWS Open Data.
# The thermal and mineral build (python -m pipeline.build_env) reads NASA LP DAAC, which
# requires a free NASA Earthdata Login. Never commit a real token.

# Backend
TAF_DATA_DIR=./data                     # where data/processed and data/sources live
TAF_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (Vite, read at build/dev time)
VITE_API_BASE=                          # empty = same origin / Vite dev proxy
VITE_PROXY_TARGET=http://127.0.0.1:8000 # dev proxy target for /api
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# Thermal and mineral build only (pipeline.build_env). Never commit real values.
# Get a token at https://urs.earthdata.nasa.gov/ -> Generate Token.
# EARTHDATA_TOKEN=
# TAF_CA_BUNDLE=                        # CA bundle for GDAL, if your network re-terminates TLS
